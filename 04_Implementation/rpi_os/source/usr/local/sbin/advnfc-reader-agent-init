#!/bin/bash
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "Run with sudo: sudo advnfc-reader-agent-init" >&2
  exit 1
fi

install -d -m 0750 -o root -g advnfc /etc/advnfc /etc/advnfc/profiles /etc/advnfc/secrets

for source in /usr/share/advnfc/profiles/*.yaml; do
  [[ -e "$source" ]] || continue
  target="/etc/advnfc/profiles/$(basename "$source")"
  if [[ ! -e "$target" ]]; then
    install -m 0644 -o root -g advnfc "$source" "$target"
    echo "Created profile: $target"
  fi
done

for source in /usr/share/advnfc/secrets/*.env.example; do
  [[ -e "$source" ]] || continue
  base="$(basename "$source" .example)"
  target="/etc/advnfc/secrets/$base"
  if [[ ! -e "$target" ]]; then
    install -m 0640 -o root -g advnfc "$source" "$target"
    echo "Created secret placeholder: $target"
  fi
done

echo
echo "Profiles and secret placeholders are installed without selecting an environment."
echo "Replace the MQTT_PASS placeholder for the profile you intend to use, then run:"
echo "  sudo advnfc-profile switch <profile>"
