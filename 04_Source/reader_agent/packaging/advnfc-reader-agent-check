#!/bin/bash
set -uo pipefail

reader_output_ok() {
  local rc="$1"
  local output="$2"

  [[ "$rc" -eq 0 ]] \
    && grep -Eqi 'NFC device:.*opened' <<<"$output" \
    && ! grep -Eqi '(^|[[:space:]])error([[:space:]]|$)|Unable to (claim|open|write|release).*' <<<"$output"
}

main() {
  local fail=0
  local version_file=/opt/advnfc/reader_agent/VERSION
  local service=advnfc-reader-agent.service

  ok()   { printf 'OK   %s\n' "$*"; }
  warn() { printf 'WARN %s\n' "$*"; }
  bad()  { printf 'FAIL %s\n' "$*"; fail=1; }

  echo "AdvNFC reader-agent readiness check"

  if [[ -r "$version_file" ]]; then
    while IFS= read -r line; do printf 'INFO %s\n' "$line"; done < "$version_file"
  else
    bad "version metadata missing: $version_file"
  fi

  for cmd in nfc-list mosquitto_pub lsusb timeout python3 advnfc-profile stat; do
    if command -v "$cmd" >/dev/null 2>&1; then
      ok "$cmd available"
    else
      bad "$cmd missing"
    fi
  done

  if getent passwd advnfc >/dev/null; then
    ok "advnfc system account exists"
  else
    bad "advnfc system account missing"
  fi

  if [[ -L /etc/advnfc/active-profile.yaml ]]; then
    if runuser -u advnfc -- advnfc-profile validate >/dev/null 2>&1; then
      ok "active profile and referenced secret validate"
      runuser -u advnfc -- advnfc-profile status 2>/dev/null | sed 's/^/INFO /'
    else
      bad "active profile or referenced secret is invalid"
      runuser -u advnfc -- advnfc-profile validate 2>&1 | tail -n 5
    fi
  else
    bad "active profile missing; run sudo advnfc-profile switch <profile>"
  fi

  local usb_line usb_bus usb_dev usb_node usb_group
  usb_line="$(lsusb -d 072f:2200 2>/dev/null | head -n 1)"
  if [[ -n "$usb_line" ]]; then
    ok "ACR122U USB device 072f:2200 detected"

    usb_bus="$(awk '{print $2}' <<<"$usb_line")"
    usb_dev="$(awk '{gsub(":", "", $4); print $4}' <<<"$usb_line")"
    usb_node="/dev/bus/usb/$usb_bus/$usb_dev"

    if [[ -e "$usb_node" ]]; then
      usb_group="$(stat -c %G "$usb_node" 2>/dev/null || true)"
      if [[ "$usb_group" == "advnfc" ]]; then
        ok "ACR122U USB device group is advnfc"
      else
        bad "ACR122U USB device group is $usb_group; expected advnfc ($usb_node)"
      fi
    else
      bad "ACR122U USB device node missing: $usb_node"
    fi
  else
    bad "ACR122U USB device 072f:2200 not detected"
  fi

  local service_was_active=0
  if systemctl is-active --quiet "$service" 2>/dev/null; then
    service_was_active=1
    if ! systemctl stop "$service"; then
      bad "could not stop $service for exclusive reader check"
    else
      # ACR122U/PN532 can remain transiently unavailable immediately after
      # the long-running agent releases it. Allow the device to settle before
      # the direct libnfc readiness probe.
      sleep 3
    fi
  fi

  local nfc_output nfc_rc
  nfc_output="$(runuser -u advnfc -- timeout 8 nfc-list 2>&1)"
  nfc_rc=$?

  if (( service_was_active )); then
    if ! systemctl start "$service"; then
      bad "could not restart $service after reader check"
    fi
  fi

  if reader_output_ok "$nfc_rc" "$nfc_output"; then
    ok "nfc-list can communicate with an NFC reader as service account advnfc"
  else
    bad "nfc-list reader check failed as service account advnfc"
    printf '%s\n' "$nfc_output" | tail -n 8
  fi

  if systemctl is-enabled --quiet "$service" 2>/dev/null; then
    ok "service enabled"
  else
    warn "service not enabled"
  fi

  if systemctl is-active --quiet "$service" 2>/dev/null; then
    ok "service active"
  else
    warn "service not active"
  fi

  return "$fail"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
