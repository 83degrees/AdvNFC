#!/bin/bash
set -uo pipefail

fail=0
ok()   { printf 'OK   %s\n' "$*"; }
warn() { printf 'WARN %s\n' "$*"; }
bad()  { printf 'FAIL %s\n' "$*"; fail=1; }

VERSION_FILE=/opt/advnfc/reader_agent/VERSION
ENV_FILE=/etc/advnfc/reader-agent.env

echo "AdvNFC reader-agent readiness check"

if [[ -r "$VERSION_FILE" ]]; then
  while IFS= read -r line; do printf 'INFO %s\n' "$line"; done < "$VERSION_FILE"
else
  bad "version metadata missing: $VERSION_FILE"
fi

for cmd in nfc-list mosquitto_pub lsusb timeout; do
  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$cmd available"
  else
    bad "$cmd missing"
  fi
done

if getent passwd advnfc >/dev/null; then
  ok "advnfc system account exists"
else
  bad "advnfc system account missing"
fi

if [[ -f "$ENV_FILE" ]]; then
  ok "node configuration exists: $ENV_FILE"
  if grep -q '^MQTT_PASS=REPLACE_WITH_DEPLOYMENT_SECRET$' "$ENV_FILE"; then
    bad "MQTT password placeholder has not been replaced"
  fi
else
  bad "node configuration missing; run sudo advnfc-reader-agent-init"
fi

if lsusb -d 072f:2200 >/dev/null 2>&1; then
  ok "ACR122U USB device 072f:2200 detected"
else
  bad "ACR122U USB device 072f:2200 not detected"
fi

nfc_output="$(timeout 8 nfc-list 2>&1)"
nfc_rc=$?
if [[ $nfc_rc -eq 0 ]] && grep -Eqi 'NFC device|ACR122|ACS' <<<"$nfc_output"; then
  ok "nfc-list can communicate with an NFC reader"
else
  bad "nfc-list reader check failed"
  printf '%s\n' "$nfc_output" | tail -n 8
fi

if systemctl is-enabled --quiet advnfc-reader-agent.service 2>/dev/null; then
  ok "service enabled"
else
  warn "service not enabled"
fi

if systemctl is-active --quiet advnfc-reader-agent.service 2>/dev/null; then
  ok "service active"
else
  warn "service not active"
fi

exit "$fail"
