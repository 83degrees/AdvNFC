# AdvNFC reader-agent deployment configuration.
# Copy to /etc/advnfc/reader-agent.env on the reader node and protect it
# appropriately. Never commit a real MQTT password.

HA_BASE_URL=http://ha-starburst.little-dory.ts.net:8123
WEBHOOK_ID=assistive_card_scan

MQTT_HOST=ha-starburst.little-dory.ts.net
MQTT_PORT=1883
MQTT_USER=ha_mqtt
MQTT_PASS=REPLACE_WITH_DEPLOYMENT_SECRET

# READER is intentionally omitted by default so hostname -s remains authoritative.
POLL_S=0.20
DEBOUNCE_S=0.80
EMPTY_RESET_LOOPS=8
